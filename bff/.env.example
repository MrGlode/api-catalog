# =============================================================================
# WSO2 BFF Server Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS - Origin allowed to make requests (your Angular app)
CORS_ORIGIN=http://localhost:4200

# =============================================================================
# WSO2 API Manager Configuration
# =============================================================================

# WSO2 Base URL
WSO2_BASE_URL=https://localhost:9443

# WSO2 Tenant
WSO2_TENANT=carbon.super

# WSO2 Service Provider (for registration)
WSO2_SP=apim_devportal

# =============================================================================
# OAuth2 Client Credentials (KEEP SECRET!)
# =============================================================================
# These credentials are obtained by registering an OAuth application in WSO2
# They should NEVER be exposed to the frontend

# Client ID (public identifier)
WSO2_CLIENT_ID=your_client_id_here

# Client Secret (KEEP SECRET - server-side only)
WSO2_CLIENT_SECRET=your_client_secret_here

# OAuth Scopes
WSO2_SCOPES=openid apim:subscribe apim:api_key apim:app_manage apim:sub_manage
